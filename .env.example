# ---------------------------------------------------------------
# 環境變數範例 — 複製此檔為 .env 並填入實際值
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# ---------------------------------------------------------------

# ---------- 應用 ----------
APP_NAME=FastAPI Template
APP_DESCRIPTION=FastAPI 專案模板
APP_VERSION=1.0.0
APP_ENV=development
APP_PORT=8000
API_V1_PREFIX=/api/v1

# 逗號分隔的允許來源。留空時：development 全開、其他環境全擋。
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- 資料庫（SQL Server）----------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# 輸出 SQL log（development 下預設已開啟）
DB_ECHO=false

# 啟動時是否依 model 自動建表。正式環境請保持 false。
DB_AUTO_CREATE=false
